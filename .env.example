# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must stay that way.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# dev  = synthetic payloads accepted (for building and testing)
# prod = synthetic payloads rejected; this database holds real data only
DATA_PROFILE=dev

# Local SQLite needs no setup. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+pysqlite:///./data/health_dev.db
# DATABASE_URL=postgresql+psycopg2://health:CHANGE_ME@localhost:5432/health

# Shared bearer token between the Android collector, the bot and the API.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me

# --- personal context (feeds the physiological formulas) -------------------
TIMEZONE=Asia/Almaty
BIRTH_YEAR=2002
SEX=female              # female | male | unspecified  (TRIMP weighting)
# HR_MAX_OVERRIDE=      # measured HRmax, if you ever test it properly

# --- analytics ------------------------------------------------------------
BASELINE_WINDOW_DAYS=28
BASELINE_MIN_OBSERVATIONS=3
SLEEP_TARGET_MINUTES=480

# --- LLM ------------------------------------------------------------------
# template = deterministic, no key, no network. Everything works without an LLM.
LLM_PROVIDER=template          # template | anthropic | openai | google | ollama
LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Telegram -------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. Anyone not on this list is ignored.
# TELEGRAM_ALLOWED_USER_IDS=
BACKEND_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
